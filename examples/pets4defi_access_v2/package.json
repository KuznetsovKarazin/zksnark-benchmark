{
  "name": "pets4defi-access-architecture-v2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "prover": "node scripts/prover_benchmark.mjs",
    "economics": "python3 scripts/economics.py --measurements results/measurements.json --out results",
    "test:economics": "python3 -m unittest discover -s scripts -p 'test_economics.py'",
    "policy:benchmark": "node scripts/policy_benchmark.mjs",
    "policy:economics": "python3 scripts/policy_economics.py",
    "policy:test": "python3 -m unittest discover -s scripts -p 'test_policy_economics.py'",
    "policy": "npm run setup && npm run policy:benchmark && npm run policy:economics && npm run policy:test",
    "demo": "npm run setup && npm run benchmark && npm run economics && npm run test:economics",
    "browser": "node browser/server.mjs"
  },
  "dependencies": {
    "circom2": "0.2.23",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "ethers": "6.17.0",
    "hardhat": "3.20.0",
    "snarkjs": "0.7.6",
    "solc": "0.8.37"
  },
  "overrides": {
    "tmp": "0.2.7",
    "underscore": "1.13.8",
    "@ethersproject/providers": {
      "ws": "8.21.0"
    }
  }
}
