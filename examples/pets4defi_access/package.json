{
  "name": "pets4defi-access-cost-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic signed-credential and Groth16 access-cost experiment",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "economics": "python3 scripts/economics.py --measurements results/measurements.json --out results",
    "test:economics": "python3 -m unittest discover -s scripts -p 'test_economics.py'",
    "demo": "npm run setup && npm run benchmark && npm run economics && npm run test:economics"
  },
  "engines": {"node": ">=20"},
  "dependencies": {
    "circom2": "0.2.23",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "ethers": "6.17.0",
    "ganache": "7.9.2",
    "snarkjs": "0.7.6",
    "solc": "0.8.37"
  }
}
